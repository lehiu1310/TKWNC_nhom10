{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "cd web && corepack pnpm install --frozen-lockfile",
  "buildCommand": "cd web && corepack pnpm run build",
  "outputDirectory": "web/dist",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://tkw-nhom10-api.onrender.com/api/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
