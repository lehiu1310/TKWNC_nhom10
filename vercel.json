{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "npm ci && cd web && corepack pnpm install --frozen-lockfile",
  "buildCommand": "cd web && corepack pnpm run build",
  "outputDirectory": "web/dist",
  "build": {
    "env": {
      "VITE_API_SAME_ORIGIN": "true"
    }
  },
  "rewrites": [
    {
      "source": "/api/auth/:path*",
      "destination": "/api/gateway?route=/api/auth/:path*"
    },
    {
      "source": "/api/account/data/:path*",
      "destination": "/api/gateway?route=/api/account/data/:path*"
    },
    {
      "source": "/api/:path*",
      "destination": "https://tkw-nhom10-api.onrender.com/api/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
