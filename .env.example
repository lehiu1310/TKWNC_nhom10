# Copy this file to .env for local backend secrets. .env is ignored by Git.
# Backend chatbot provider. Never commit real API keys.
LLM_PROVIDER=gemini
GEMINI_MODEL=gemini-3.5-flash-lite
GOOGLE_API_KEY=

# Frontend: leave blank for the local Vite proxy, or set deployed API base URL.
VITE_API_BASE_URL=

# Comma-separated allowed browser origins; add the deployed Vercel domain.
CORS_ORIGINS=http://localhost:5175,http://127.0.0.1:5175
