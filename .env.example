# Copy this file to .env for local backend secrets. .env is ignored by Git.
# Backend chatbot provider. Never commit real API keys.
LLM_PROVIDER=gemini
GEMINI_MODEL=gemini-3.5-flash-lite
GOOGLE_API_KEY=
MODEL_WARMUP=0
RENDER_FREE_MEMORY=1
RETRIEVAL_BACKEND=classifier
TORCH_NUM_THREADS=1
CLASSIFIER_RETRIEVAL_LABEL_MIN_CONFIDENCE=0.4

# Experimental classifier rejection threshold; needs a labeled flower/non-flower calibration set.
CLASSIFIER_OOD_MIN_CONFIDENCE=0.6967

# Frontend: leave blank for the local Vite proxy, or set deployed API base URL.
VITE_API_BASE_URL=

# SQLite stores local accounts, sessions, Sổ hoa and Cây của tôi.
APP_DB_PATH=.data/vuonhoa.sqlite3

# Comma-separated allowed browser origins; add the deployed Vercel domain.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5175,http://127.0.0.1:5175,https://tkwnc-nhom10.vercel.app
